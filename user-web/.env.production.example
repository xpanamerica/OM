# =============================================================================
# 本机 Beta / Nginx 同源构建 — 复制为 .env.production 后执行 npm run build
# （仓库内文件名：.env.production.example；实际构建使用 .env.production，勿提交密钥）
# =============================================================================
# 与 deploy/local-beta/nginx 一致：浏览器访问 /api/v1 → Nginx → 后端；隧道只需映射 8080。
# 成片可存本站磁盘，播放 URL 由后端签发；使用阿里云点播时无需在此配置 AK/SK。

VITE_API_BASE_URL=/api/v1
