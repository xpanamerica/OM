# 后端 API 根路径（含 /api/v1 前缀），勿在代码中写死。
#
# 推荐（与 deploy/local-beta 一致）：先启动 local-beta，再走 Nginx 同源 API。
VITE_API_BASE_URL=http://127.0.0.1:8081/api/v1
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#
# 若仅启动 backend/docker-compose 中的 api（监听 127.0.0.1:8000），改为：
# VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
