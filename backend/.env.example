# =============================================================================
# 环境变量模板（Compose + 本机直跑 Uvicorn）
# =============================================================================
# - Docker Compose 会读取 **本目录** ``.env`` 做 YAML 变量替换。
# - **SECRET_KEY** 与 **POSTGRES_PASSWORD** 已无 compose 内联弱默认，首次起栈前须配置：
#     cd backend && bash scripts/init_local_compose_env.sh
#   将生成随机 ``.env``（勿提交 Git）。已存在 ``.env`` 时脚本不会覆盖。
# - ``api.environment.ENVIRONMENT`` 在默认 compose 中写死为 ``local``。
# - 数据库 URL 中口令若含特殊字符须做百分号编码。
# =============================================================================

# Docker Compose：拉取超时（deadline exceeded）时可加大
COMPOSE_HTTP_TIMEOUT=300
# 官方 Hub（海外网络）：取消下行三行注释并注释掉 DaoCloud 行，或 export 覆盖
# MEDIA_POSTGRES_IMAGE=postgres:16-alpine
# MEDIA_REDIS_IMAGE=redis:7-alpine
# MEDIA_PYTHON_IMAGE=python:3.11-slim
MEDIA_POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
MEDIA_REDIS_IMAGE=docker.m.daocloud.io/library/redis:7-alpine
MEDIA_PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.11-slim

# 以下密钥类变量由 init_local_compose_env.sh 写入 .env；此处仅作文档占位（勿手写弱口令）
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_DB=videodb
# SECRET_KEY=
# DATABASE_URL=
# REDIS_URL=redis://redis:6379/0
# FIRST_SUPERUSER_EMAIL=
# FIRST_SUPERUSER_USERNAME=
# FIRST_SUPERUSER_PASSWORD=

# App（本机直跑 uvicorn 时可取消注释并按需填写）
APP_NAME=video-knowledge-api
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
# Access token 保持短期有效；长期会话由 HttpOnly refresh token 维持
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# 本地 HTTP 开发可保留 false；HTTPS/生产建议 true
REFRESH_TOKEN_COOKIE_SECURE=false
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5173
# EXPOSE_INTERNAL_ERROR_DETAILS=false
# 仅当 API 始终经 HTTPS 提供且已关闭 OpenAPI 文档时，可设置 HSTS max-age（秒）；默认 0 不发送
# SECURITY_HSTS_MAX_AGE=31536000
# AUTH_RATE_LIMIT_ENABLED=true
# AUTH_RATE_LIMIT_USE_REDIS=true
# AUTH_RATE_LIMIT_REDIS_FALLBACK_MEMORY=true
# AUTH_RATE_LIMIT_REDIS_STALE_REPROBE_SECONDS=30
# AUTH_RATE_LIMIT_REGISTER_PER_IP_PER_MINUTE=3
# AUTH_RATE_LIMIT_REGISTER_PER_IP_PER_HOUR=10
# AUTH_RATE_LIMIT_LOGIN_PER_IP_PER_MINUTE=5
# AUTH_RATE_LIMIT_LOGIN_FAIL_WINDOW_SECONDS=900
# AUTH_RATE_LIMIT_LOGIN_FAIL_MAX_PER_ACCOUNT=5
# AUTH_RATE_LIMIT_FORGOT_PER_IP_PER_HOUR=3
# AUTH_RATE_LIMIT_FORGOT_PER_EMAIL_PER_HOUR=2
# AUTH_RATE_LIMIT_REGISTER_MINUTE_WINDOW_SECONDS=60
# AUTH_RATE_LIMIT_REGISTER_HOUR_WINDOW_SECONDS=3600
# AUTH_RATE_LIMIT_LOGIN_IP_WINDOW_SECONDS=60
# AUTH_RATE_LIMIT_FORGOT_WINDOW_SECONDS=3600
# 注册「每分钟」上限：0=沿用 AUTH_RATE_LIMIT_REGISTER_PER_IP_PER_MINUTE；生产可单独设 20–60
# AUTH_REGISTER_MAX_ATTEMPTS_PER_MINUTE=0
# Cloudflare Turnstile：注册必验；登录同一标识失败 3 次后必验。Secret 仅后端使用，勿写入前端。
# TURNSTILE_SECRET=
# TURNSTILE_LOGIN_FAILURE_THRESHOLD=3
# 可选：开启后会校验 Cloudflare Siteverify 返回的 hostname，建议生产填写公网域名
# TURNSTILE_ALLOWED_HOSTNAMES=app.example.com,admin.example.com
# 测试绕过仅允许 NODE_ENV=test；生产/本地外测不要开启。
# NODE_ENV=
# TURNSTILE_BYPASS=false
# AUTH_TRUST_X_FORWARDED_FOR=false
# 忘记密码：令牌 TTL（秒）；noop=仅落库不发信；log=INFO 打日志（开发）；smtp=发邮件（须配 SMTP_* 与模板含 {token}）
# AUTH_PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
# AUTH_PASSWORD_RESET_EMAIL_BACKEND=noop
# AUTH_PASSWORD_RESET_EMAIL_FROM=noreply@example.com
# AUTH_PASSWORD_RESET_PUBLIC_LINK_TEMPLATE=https://your-frontend.example/reset?token={token}
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=true
# 为 true 时 ``GET /metrics`` 暴露 Prometheus 文本（评论、播放记录、VOD 刷新成功/阿里云错误/限流、附件限流等）；仅受信网络或 sidecar 抓取时开启
# EXPOSE_PROMETHEUS_METRICS=false

# --- 阿里云 VOD（阶段 11.1：上传凭证接口；勿提交含真实 AK 的 .env）---
# ALIYUN_ACCESS_KEY_ID=
# ALIYUN_ACCESS_KEY_SECRET=
# ALIYUN_VOD_REGION=cn-shanghai
# ALIYUN_VOD_TEMPLATE_GROUP_ID=
# ALIYUN_VOD_WORKFLOW_ID=
# GetVideoPlayAuth 凭证 TTL（秒，60–2592000）；默认 3000
# ALIYUN_VOD_PLAY_AUTH_TIMEOUT_SECONDS=3000
# VOD HTTP 回调：请求头 X-VOD-Callback-Secret 须与此一致（勿提交真实值）
# ALIYUN_VOD_CALLBACK_SECRET=
# 每用户每 60 秒滑动窗口内刷新上传凭证次数上限；0 关闭；管理员不受限
# VOD_REFRESH_UPLOAD_MAX_PER_USER_PER_MINUTE=60
# 为 true 且 Redis 可达时，上述限流用 Redis（多实例一致）；Redis 故障时是否回退进程内
# VOD_REFRESH_UPLOAD_RATE_LIMIT_USE_REDIS=true
# VOD_REFRESH_UPLOAD_RATE_LIMIT_REDIS_FALLBACK_MEMORY=true

# --- 稿件附属文件（POST /videos/{id}/attachments；本地磁盘）---
# ATTACHMENT_STORAGE_DIR=data/attachments
# MAX_ATTACHMENT_SIZE_MB=50
# MAX_ATTACHMENTS_PER_VIDEO=20
# ALLOWED_ATTACHMENT_EXTENSIONS=jpg,jpeg,png,webp,gif,bmp,pdf,doc,docx,xls,xlsx,ppt,pptx,txt,zip
# 附件魔数与扩展名交叉校验（防伪装）；排查兼容问题时可设 false
# ATTACHMENT_VERIFY_FILE_MAGIC=true
# 磁盘剩余空间须至少保留（MB），否则拒绝附件上传（507）
# ATTACHMENT_MIN_RESERVED_DISK_MB=256
# 每用户每 60 秒滑动窗口内附件 POST 次数上限（0 关闭限流）
# ATTACHMENT_POST_MAX_PER_USER_PER_MINUTE=60
# ATTACHMENT_POST_RATE_LIMIT_USE_REDIS=true
# ATTACHMENT_POST_RATE_LIMIT_REDIS_FALLBACK_MEMORY=true
