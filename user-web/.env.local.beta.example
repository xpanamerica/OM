# 开发态（vite dev）可选用本文件复制为 .env.local。
# 本机 Beta 正式构建请用：cp .env.production.example .env.production && npm run build
# （生产模式构建才会读 .env.production，与 Nginx 8080/8081 同源反代一致。）

# 同源反代（推荐）：浏览器请求 /api/v1 → Nginx → 后端
VITE_API_BASE_URL=/api/v1
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# 若前端与 API 不同源，改为完整 URL，例如：
# VITE_API_BASE_URL=https://你的-api-隧道子域.ngrok-free.app/api/v1
