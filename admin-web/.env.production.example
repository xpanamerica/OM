# =============================================================================
# 本机 Beta / Nginx 同源构建 — 复制为 .env.production 后执行 npm run build
# （与 user-web 相同策略；管理端由 Nginx :8081 提供，同源 /api/v1）
# Cloudflare Tunnel 下须给管理端单独 hostname 指向 127.0.0.1:8081，否则后台功能不会出现在公网域名上。
# =============================================================================

VITE_API_BASE_URL=/api/v1
