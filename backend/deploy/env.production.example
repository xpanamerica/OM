# 复制为 backend/.env.production 并填写（勿提交真实文件）
# 用法：docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# ---------- 数据库（与 compose 中 db 服务一致）----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-random
POSTGRES_DB=videodb
DATABASE_URL=postgresql+psycopg://postgres:change-me-strong-random@db:5432/videodb

# ---------- 应用 ----------
SECRET_KEY=replace-with-utf8-secret-at-least-32-chars-long!!
REDIS_URL=redis://redis:6379/0

# 置于 Nginx 等反代之后时建议 true
AUTH_TRUST_X_FORWARDED_FOR=true

# Gunicorn Uvicorn worker 数（CPU 核数或 2n+1 经验值）
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=120

# 日志目录（容器内路径；compose 已挂载卷到此处）
LOG_FILE_DIR=/var/log/media-api
LOG_LEVEL=INFO

# 可选：首启初始化管理员（见 init_db；生产务必改强口令）
# FIRST_SUPERUSER_EMAIL=admin@yourdomain.com
# FIRST_SUPERUSER_USERNAME=admin
# FIRST_SUPERUSER_PASSWORD=...

# 镜像加速（可选）
# MEDIA_PYTHON_IMAGE=registry.cn-hangzhou.aliyuncs.com/acs/python:3.12-slim-bookworm
# MEDIA_POSTGRES_IMAGE=postgres:16-alpine
# MEDIA_REDIS_IMAGE=redis:7-alpine
