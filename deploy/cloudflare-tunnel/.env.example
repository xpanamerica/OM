# Cloudflare Tunnel compose 覆盖文件读取；复制为 .env，勿提交真实 token。

# Cloudflare Zero Trust → Networks → Tunnels → 你的 Tunnel → Install and run a connector → Docker token
CLOUDFLARED_TUNNEL_TOKEN=

# 可选：如果用户站和管理端分别创建了两个 Named Tunnel，把用户站 Docker token 填这里。
CLOUDFLARED_USER_TUNNEL_TOKEN=

# 可选：国内拉取困难时可替换镜像源
# MEDIA_CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest
