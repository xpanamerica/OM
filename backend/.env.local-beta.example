# =============================================================================
# 阶段 19-local-beta — 后端（Docker Compose 内 api 容器读取）
# 复制为 backend/.env.local-beta 并填写；勿提交真实文件到 Git。
# =============================================================================
# Compose 对 db 服务做变量替换时也会读取同一文件（见仓库根 docker-compose.local-beta.yml
# 推荐用法）：docker compose --env-file ./backend/.env.local-beta -f docker-compose.local-beta.yml up -d
# 因此本文件须同时包含：POSTGRES_*（与 DATABASE_URL 口令一致）、SECRET_KEY、业务变量。

# --- 数据库（容器网络内主机名必须为 db）---
# 本机 Beta compose 默认把 Postgres 映到宿主机 127.0.0.1:15432（避免与另一套 docker 的 5432 冲突）；用 psql/pg_dump 从宿主机连时用 15432，勿改 DATABASE_URL 里的 @db:5432。
POSTGRES_USER=postgres
POSTGRES_DB=videodb
POSTGRES_PASSWORD=请替换为强随机口令
# 须与 POSTGRES_PASSWORD 一致；口令含 @ # 等特殊字符时请做 URL 百分号编码
DATABASE_URL=postgresql+psycopg://postgres:请替换为强随机口令@db:5432/videodb

# --- Redis（容器网络内主机名必须为 redis）---
REDIS_URL=redis://redis:6379/0

# --- 应用 ---
APP_NAME=video-knowledge-api
# local / development：允许 CORS_ORIGINS 含 *；若隧道 HTTPS 与本地混用可显式列 Origin
ENVIRONMENT=local
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
SECRET_KEY=请使用 openssl rand -hex 32 生成至少 32 字节 UTF-8 密钥
# 用户端「长期保持登录」：在配置允许范围内尽量加长（上限 60×24×30 分钟 ≈ 30 天）
ACCESS_TOKEN_EXPIRE_MINUTES=20160

# 经 Nginx 反代 + 隧道时，反代须传 X-Forwarded-*；限流按真实客户端 IP 时可开
AUTH_TRUST_X_FORWARDED_FOR=true
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_USE_REDIS=true
AUTH_RATE_LIMIT_REDIS_FALLBACK_MEMORY=true

# 内测：同源反代时可用相对路径前端；若前端独立域名再列出完整 Origin（逗号分隔）
# CORS_ORIGINS=http://127.0.0.1:8080,http://127.0.0.1:8081,https://你的隧道子域.trycloudflare.com

# 首个管理员（库中尚无同名邮箱/用户名时，由 init_db 在 API 启动时创建一次）
# 管理端登录：在「用户名或邮箱」填下面其一即可（用户名现已大小写不敏感）；密码须与 FIRST_SUPERUSER_PASSWORD 完全一致。
# 重要：若你曾成功启动过、后来又改了 FIRST_SUPERUSER_PASSWORD，库里的旧密码不会自动更新。
# 可改回旧密码登录；或在仓库根执行：ADMIN_RESET_PASSWORD=新密码 ./deploy/local-beta/scripts/reset_admin_password_in_db.sh
# 或 docker compose ... down -v 后 up（会丢库内全部数据）。
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_USERNAME=admin
# 内测临时口令（≥8 位）；若库中已有同名管理员，仅改此处不会更新数据库密码，需 down -v 后重建或改回旧口令登录。
FIRST_SUPERUSER_PASSWORD=admin2026

# --- 阿里云 VOD（播放与上传凭证；服务端使用，勿进前端仓库）---
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_VOD_REGION=cn-shanghai
# ALIYUN_VOD_TEMPLATE_GROUP_ID=
# ALIYUN_VOD_WORKFLOW_ID=
# ALIYUN_VOD_PLAY_AUTH_TIMEOUT_SECONDS=3000
# ALIYUN_VOD_CALLBACK_SECRET=
# VOD_REFRESH_UPLOAD_MAX_PER_USER_PER_MINUTE=60
# VOD_REFRESH_UPLOAD_RATE_LIMIT_USE_REDIS=true
# VOD_REFRESH_UPLOAD_RATE_LIMIT_REDIS_FALLBACK_MEMORY=true

# 可选：内测开 Swagger/ReDoc（经 Nginx /docs、/redoc 访问）
# EXPOSE_OPENAPI_DOCS=true

# 前端构建：user-web / admin-web 使用 .env.production（见各目录 .env.production.example），勿把 AK/SK 写进前端。

# --- 本机成片（免阿里云亦可播放；compose 默认挂载 ./backend:/app 时相对路径落在宿主机 backend/data/ 下）---
LOCAL_VIDEO_STORAGE_DIR=data/local_videos
# 视频封面 JPEG 落盘目录（相对 backend 工作目录；与 GET /api/v1/covers/{id}.jpg 对应）
# VIDEO_COVER_STORAGE_DIR=data/video_covers
# VIDEO_COVER_MAX_UPLOAD_MB=8
# LOCAL_VIDEO_PLAY_TOKEN_SECONDS=7200
# 隧道/反代下若播放 URL 域名不对，可设（须含 /api/v1、无尾斜杠）：API_PUBLIC_BASE_URL=https://你的域名/api/v1

# --- 稿件附件（与成片相同：默认 data/attachments，持久化在挂载的 backend 目录下）---
ATTACHMENT_STORAGE_DIR=data/attachments
# MAX_ATTACHMENT_SIZE_MB=50
# 小磁盘或内测强烈建议 0，否则剩余空间 < 预留+单文件上限时会 507 拒绝上传
ATTACHMENT_MIN_RESERVED_DISK_MB=0
# ATTACHMENT_POST_MAX_PER_USER_PER_MINUTE=60
# ATTACHMENT_POST_RATE_LIMIT_USE_REDIS=true
# ATTACHMENT_POST_RATE_LIMIT_REDIS_FALLBACK_MEMORY=true
