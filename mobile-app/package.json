{
  "name": "om-media-mobile",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "EXPO_NO_TYPESCRIPT_SETUP=1 node ./node_modules/expo/bin/cli start",
    "android": "EXPO_NO_TYPESCRIPT_SETUP=1 node ./node_modules/expo/bin/cli start --android",
    "ios": "EXPO_NO_TYPESCRIPT_SETUP=1 node ./node_modules/expo/bin/cli start --ios",
    "web": "EXPO_NO_TYPESCRIPT_SETUP=1 node ./node_modules/expo/bin/cli start --web",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit",
    "deps:expo-sync": "node ./node_modules/expo/bin/cli install --fix",
    "deps:audit": "npm audit",
    "deps:audit:high": "npm audit --audit-level=high",
    "deps:audit:fix": "npm audit fix",
    "deps:security": "npm audit fix && npm audit",
    "deps:check": "npm run typecheck"
  },
  "dependencies": {
    "@expo/metro-runtime": "~3.2.3",
    "@expo/vector-icons": "^14.0.2",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@tanstack/react-query": "^5.66.0",
    "expo": "~51.0.39",
    "expo-av": "~14.0.7",
    "expo-constants": "~16.0.2",
    "expo-document-picker": "^55.0.13",
    "expo-image": "~1.13.0",
    "expo-image-picker": "^55.0.19",
    "expo-secure-store": "~13.0.2",
    "expo-status-bar": "~1.12.1",
    "expo-video-thumbnails": "^55.0.14",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-native": "0.74.5",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "~0.19.10",
    "react-native-webview": "^13.16.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~18.2.79",
    "typescript": "~5.6.3"
  },
  "overrides": {
    "semver": "^7.6.3",
    "send": "^0.19.2",
    "node-fetch": "^2.7.0",
    "cacache": {
      "glob": "10.4.5"
    }
  }
}
